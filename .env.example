# ─────────────────────────────────────────────────────────────────
#  TRADING BOT — Variables d'environnement
#  Copie ce fichier en .env et remplis tes vraies valeurs
#  ⚠️  Ne jamais commiter le fichier .env sur GitHub
# ─────────────────────────────────────────────────────────────────

# ── MT5 / EXNESS (Forex + XAU/USD) ───────────────────────────────
MT5_LOGIN=410646538
MT5_PASSWORD=ton_mot_de_passe_trading_mt5
MT5_SERVER=Exness-MT5Real10

# ── BINANCE (BTC/USD) ─────────────────────────────────────────────
CCXT_EXCHANGE=binance
CCXT_API_KEY=ta_clé_api_binance
CCXT_API_SECRET=ton_secret_binance
CCXT_SANDBOX=false

# ── DONNÉES MARCHÉ — Twelve Data ──────────────────────────────────
TWELVE_DATA_KEY=ta_clé_twelve_data

# ── FILTRE ACTUALITÉS — NewsAPI ───────────────────────────────────
NEWS_API_KEY=ta_clé_newsapi

# ── IA OPTIONNELLE — Groq ────────────────────────────────────────
GROQ_API_KEY=ta_clé_groq
GROQ_MODEL=mixtral-8x7b-32768

# ── TELEGRAM ─────────────────────────────────────────────────────
TELEGRAM_TOKEN=ton_token_telegram
TELEGRAM_CHANNEL_ID=ton_channel_id
TELEGRAM_ADMIN_ID=ton_id_personnel

# ── BASE DE DONNÉES ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/tradingbot

# ── PARAMÈTRES DU BOT ────────────────────────────────────────────
BOT_ENV=development
LOG_LEVEL=INFO
RISK_PER_TRADE=1.0
MAX_DAILY_LOSS=3.0
MAX_OPEN_TRADES=5
MIN_CONFLUENCE_SCORE=75

# ── DASHBOARD ────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change_this_to_a_random_secret_key

# ── BACKTESTING ──────────────────────────────────────────────────
BACKTEST_MONTHS=6

# ── OPTIMISATION ADAPTATIVE ──────────────────────────────────────
OPTIMIZER_ENABLED=true
OPTIMIZER_TRIALS=100
OPTIMIZER_INTERVAL_DAYS=7
