# ─────────────────────────────────────────────────────────────────
#  TRADING BOT — Variables d'environnement
#  Copie ce fichier en .env et remplis tes vraies valeurs
#  ⚠️  Ne jamais commiter le fichier .env sur GitHub
# ─────────────────────────────────────────────────────────────────

# ── DONNÉES MARCHÉ — Twelve Data ─────────────────────────────────
TWELVE_DATA_KEY=your_twelve_data_key_here

# ── EXÉCUTION ORDRES — OANDA (Forex + XAU/USD) ───────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice

# ── EXÉCUTION ORDRES — CCXT (BTC/USD) ────────────────────────────
CCXT_EXCHANGE=binance
CCXT_API_KEY=your_ccxt_api_key_here
CCXT_API_SECRET=your_ccxt_api_secret_here
CCXT_SANDBOX=true

# ── FILTRE ACTUALITÉS — NewsAPI ───────────────────────────────────
NEWS_API_KEY=your_news_api_key_here

# ── IA OPTIONNELLE — Groq ────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# ── TELEGRAM ─────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_token_here
TELEGRAM_CHANNEL_ID=your_channel_id_here
TELEGRAM_ADMIN_ID=your_personal_chat_id

# ── BASE DE DONNÉES ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/tradingbot

# ── PARAMÈTRES DU BOT ────────────────────────────────────────────
BOT_ENV=development
LOG_LEVEL=INFO
RISK_PER_TRADE=1.0
MAX_DAILY_LOSS=3.0
MAX_OPEN_TRADES=5
MIN_CONFLUENCE_SCORE=75

# ── DASHBOARD ────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change_this_to_a_random_secret_key

# ── BACKTESTING ──────────────────────────────────────────────────
BACKTEST_MONTHS=6

# ── OPTIMISATION ADAPTATIVE ──────────────────────────────────────
OPTIMIZER_ENABLED=true
OPTIMIZER_TRIALS=100
OPTIMIZER_INTERVAL_DAYS=7
